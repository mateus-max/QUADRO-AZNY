{
  "rules": {
    ".read": "auth != null && auth.token.email === 'suporte@domingas.com'",
    ".write": "auth != null && auth.token.email === 'suporte@domingas.com'",
    "roomAccess": {
      ".read": false,
      ".write": false
    },
    "licenses": {
      ".read": "auth != null && (auth.token.email === 'suporte@domingas.com' || (query.orderByChild === 'teacherEmail' && query.equalTo === auth.token.email))",
      ".indexOn": [
        "teacherEmail"
      ],
      "$licenseId": {
        ".read": "auth != null && (auth.token.email === 'suporte@domingas.com' || data.child('teacherUid').val() === auth.uid || data.child('teacherEmail').val() === auth.token.email)",
        ".write": "auth != null && auth.token.email === 'suporte@domingas.com'"
      }
    },
    "aznyRooms": {
      "$room": {
        "activeSessionId": {
          ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'",
          ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
        },
        "board": {
          ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'",
          ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved' && (root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' || root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'student')",
          ".validate": "newData.hasChildren(['currentPage','pages']) && newData.child('currentPage').isNumber() && newData.child('currentPage').val() >= 1 && newData.child('currentPage').val() <= 5 && newData.child('pages').hasChildren() && newData.child('pages').numChildren() <= 5 && (!newData.child('lastEditorUid').exists() || newData.child('lastEditorUid').val() === auth.uid)"
        },
        "sharedBrowser": {
          ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'",
          ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
        },
        "pianoEvent": {
          ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'",
          ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
        },
        "spreadsheet": {
          ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'",
          ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved' && (root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' || root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'student')"
        },
        "webDocument": {
          ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'",
          ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved' && (root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' || root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'student')"
        },
        "sessions": {
          "$session": {
            ".read": false,
            ".write": false,
            "status": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "teacherPresence": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "teacherReloadNotice": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "runId": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "startedAt": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "endedAt": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "title": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "teacherUid": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "joinRequests": {
              ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'",
              "$request": {
                ".read": "auth != null && (data.child('studentUid').val() === auth.uid || (root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'))",
                ".write": "auth != null && ((root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved') || (!data.exists() && newData.child('studentUid').val() === auth.uid && newData.child('status').val() === 'pending') || (data.child('studentUid').val() === auth.uid && newData.child('studentUid').val() === auth.uid && newData.child('status').val() === data.child('status').val()))",
                ".validate": "!newData.exists() || (newData.hasChildren(['studentUid','name','status']) && newData.child('studentUid').isString() && newData.child('name').isString() && newData.child('status').isString() && ((root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved' && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'approved' || newData.child('status').val() === 'rejected')) || (newData.child('studentUid').val() === auth.uid && (newData.child('status').val() === 'pending' || newData.child('status').val() === data.child('status').val()))))"
              }
            },
            "peers": {
              "$request": {
                ".read": "auth != null && ((root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved') || (root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved' && root.child('roomAccess').child($room).child(auth.uid).child('requestId').val() === $request))",
                ".write": "auth != null && ((root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved') || (root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved' && root.child('roomAccess').child($room).child(auth.uid).child('requestId').val() === $request))"
              },
              ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'teacher' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved'"
            },
            "studentMesh": {
              "$from": {
                "$to": {
                  ".read": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'student' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved' && (root.child('roomAccess').child($room).child(auth.uid).child('requestId').val() === $from || root.child('roomAccess').child($room).child(auth.uid).child('requestId').val() === $to)",
                  ".write": "auth != null && root.child('roomAccess').child($room).child(auth.uid).child('role').val() === 'student' && root.child('roomAccess').child($room).child(auth.uid).child('status').val() === 'approved' && (root.child('roomAccess').child($room).child(auth.uid).child('requestId').val() === $from || root.child('roomAccess').child($room).child(auth.uid).child('requestId').val() === $to)"
                }
              }
            }
          }
        }
      }
    },
    "aznyShortLinks": {
      "$code": {
        ".read": true,
        ".write": false
      }
    },
    "users": {
      ".read": false,
      ".write": false
    },
    "profiles": {
      ".read": false,
      ".write": false
    },
    "payments": {
      ".read": false,
      ".write": false
    },
    "paymentRequests": {
      ".read": "auth != null && (auth.token.email === 'suporte@domingas.com' || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      ".indexOn": [
        "uid",
        "email",
        "status"
      ],
      "$requestId": {
        ".read": "auth != null && (auth.token.email === 'suporte@domingas.com' || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && (auth.token.email === 'suporte@domingas.com' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('accessGranted').val() === false))",
        ".validate": "auth != null && (auth.token.email === 'suporte@domingas.com' || (newData.hasChildren(['id','uid','email','name','status','createdAt']) && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('accessGranted').val() === false))"
      }
    },
    "admin": {
      ".read": false,
      ".write": false
    },
    "recordings": {
      ".read": false,
      ".write": false
    },
    "auditLogs": {
      ".read": false,
      ".write": false
    },
    "notifications": {
      ".read": false,
      ".write": false
    },
    "teacherAccounts": {
      ".read": "auth != null && (auth.token.email === 'suporte@domingas.com' || query.orderByChild === 'uid' && query.equalTo === auth.uid)",
      ".indexOn": [
        "uid",
        "email"
      ],
      "$uid": {
        ".read": "auth != null && (auth.token.email === 'suporte@domingas.com' || auth.uid === $uid)",
        ".write": "auth != null && (auth.token.email === 'suporte@domingas.com' || (!data.exists() && auth.uid === $uid && newData.child('uid').val() === auth.uid && newData.child('accountStatus').val() === 'pending'))",
        ".validate": "auth != null && (auth.token.email === 'suporte@domingas.com' || (newData.hasChildren(['uid','name','email','role','accountStatus']) && newData.child('uid').val() === auth.uid && newData.child('email').val() === auth.token.email && newData.child('role').val() === 'teacher' && newData.child('accountStatus').val() === 'pending'))"
      }
    }
  }
}
