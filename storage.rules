rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /paymentProofs/{uid}/{fileName} {
      // O professor autenticado só pode enviar ficheiros para a sua própria pasta.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType.matches('(image/png|image/jpeg|image/webp|application/pdf)');
      // Os comprovativos são privados; apenas a Administração pode lê-los.
      allow read: if request.auth != null
        && request.auth.token.email == 'suporte@domingas.com';
    }

    // Publicações oficiais da Direcção: leitura pública e gestão exclusiva da Administração.
    match /adminPublications/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'suporte@domingas.com'
        && (request.resource == null || (
          request.resource.size > 0
          && ((request.resource.contentType.matches('image/.*') && request.resource.size <= 15 * 1024 * 1024)
            || (request.resource.contentType.matches('video/.*') && request.resource.size <= 100 * 1024 * 1024))
        ));
    }

    // Anexos privados do Chat de Suporte: acesso apenas ao professor dono e à Direcção.
    match /supportChat/{teacherUid}/{messageId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == teacherUid || request.auth.token.email == 'suporte@domingas.com');
      allow write: if request.auth != null
        && (request.auth.uid == teacherUid || request.auth.token.email == 'suporte@domingas.com')
        && (request.resource == null || (
          request.resource.size > 0
          && request.resource.size <= 25 * 1024 * 1024
          && request.resource.contentType.matches('(image/.*|video/.*|audio/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument\\..*|text/plain)')
        ));
    }


    // Demonstrações públicas dos cursos: leitura pública com suporte a streaming; só o professor dono pode enviar ou eliminar.
    match /teacherDemos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (request.resource == null || (
          request.resource.size > 0
          && request.resource.size <= 6 * 1024 * 1024
          && request.resource.contentType.matches('video/(mp4|webm)')
        ));
    }

    // Fotografias públicas dos perfis profissionais e capas de cursos.
    match /teacherDirectory/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}